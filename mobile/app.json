{
  "expo": {
    "name": "Nanki — Medical Study & Quizzes",
    "slug": "nanki",
    "version": "1.0.0",
    "description": "High-yield medical question banks, clinical review MCQs, and spaced repetition flashcards for medical students and healthcare professionals.",
    "scheme": "nanki",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#562788"
    },
    "ios": {
      "bundleIdentifier": "com.nanki.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nanki.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#562788"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.INTERNET"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-haptics",
      "expo-clipboard"
    ]
  }
}
